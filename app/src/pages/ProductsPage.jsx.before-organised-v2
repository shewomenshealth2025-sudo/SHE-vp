export default function ProductsPage() {
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All");
  const [sort, setSort] = useState("Recommended");
  const [maxPrice, setMaxPrice] = useState(300);
  const [minimumScore, setMinimumScore] = useState(0);
  const [reusableOnly, setReusableOnly] = useState(false);
  const [showFilters, setShowFilters] = useState(false);
  const [savedIds, setSavedIds] = useState(getSavedProducts);
  const [compareIds, setCompareIds] = useState([]);
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [showSavedOnly, setShowSavedOnly] = useState(false);
  const [showCatalogue, setShowCatalogue] = useState(false);

  useEffect(() => {
    localStorage.setItem(
      "she-saved-products",
      JSON.stringify(savedIds),
    );
  }, [savedIds]);

  const filteredProducts = useMemo(() => {
    const normalisedSearch = search.trim().toLowerCase();

    const result = products.filter((product) => {
      const matchesSearch =
        !normalisedSearch ||
        [
          product.name,
          product.brand,
          product.category,
          product.description,
          product.badge,
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase()
          .includes(normalisedSearch);

      const matchesCategory =
        category === "All" || product.category === category;

      const matchesPrice = product.price <= maxPrice;
      const matchesScore = product.score >= minimumScore;
      const matchesReusable = !reusableOnly || product.reusable;
      const matchesSaved =
        !showSavedOnly || savedIds.includes(product.id);

      return (
        matchesSearch &&
        matchesCategory &&
        matchesPrice &&
        matchesScore &&
        matchesReusable &&
        matchesSaved
      );
    });

    return [...result].sort((a, b) => {
      if (sort === "Highest SHE Score") return b.score - a.score;
      if (sort === "Price: low to high") return a.price - b.price;
      if (sort === "Price: high to low") return b.price - a.price;
      if (sort === "Most popular") return b.reviews - a.reviews;
      if (sort === "Newest") {
        return Number(b.newProduct) - Number(a.newProduct);
      }

      return (
        Number(b.featured) - Number(a.featured) ||
        b.score - a.score
      );
    });
  }, [
    category,
    maxPrice,
    minimumScore,
    reusableOnly,
    savedIds,
    search,
    showSavedOnly,
    sort,
  ]);

  const comparedProducts = compareIds
    .map((id) => products.find((product) => product.id === id))
    .filter(Boolean);

  function toggleSaved(id) {
    setSavedIds((current) =>
      current.includes(id)
        ? current.filter((savedId) => savedId !== id)
        : [...current, id],
    );
  }

  function toggleCompare(product) {
    setCompareIds((current) => {
      if (current.includes(product.id)) {
        return current.filter((id) => id !== product.id);
      }

      if (current.length >= 3) {
        return [...current.slice(1), product.id];
      }

      return [...current, product.id];
    });
  }

  function handlers(product) {
    return {
      isSaved: savedIds.includes(product.id),
      isCompared: compareIds.includes(product.id),
      onSave: toggleSaved,
      onCompare: toggleCompare,
      onOpen: setSelectedProduct,
    };
  }

  const featuredProducts = products
    .filter((product) => product.featured)
    .sort((a, b) => b.score - a.score);

  const underFifteen = products
    .filter((product) => product.price < 15)
    .sort((a, b) => b.score - a.score);

  const reusableProducts = products
    .filter((product) => product.reusable)
    .sort((a, b) => b.score - a.score);

  const popularProducts = products
    .filter((product) => product.popular)
    .sort((a, b) => b.reviews - a.reviews);

  const catalogueVisible =
    showCatalogue ||
    search ||
    category !== "All" ||
    showSavedOnly ||
    reusableOnly ||
    minimumScore > 0 ||
    maxPrice < 300;

  return (
    <div className="min-h-screen bg-[#fffdfd] text-[#211d1f]">
      <main className="mx-auto max-w-[1420px] px-5 pb-32 pt-8 sm:px-8 lg:px-12">
        <header className="relative overflow-hidden rounded-[34px] border border-[#f5dfe6] bg-gradient-to-br from-[#fff8fa] via-white to-[#fff3f7] px-6 py-10 md:px-10 md:py-14">
          <div className="absolute -right-24 -top-32 h-96 w-96 rounded-full bg-[#ffdce7]/50 blur-3xl" />
          <div className="absolute -bottom-40 left-1/3 h-80 w-80 rounded-full bg-[#fff0f4] blur-3xl" />

          <div className="relative grid gap-10 xl:grid-cols-[1fr_390px] xl:items-end">
            <div>
              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-[#f43f72] shadow-sm">
                <ShoppingBag size={25} />
              </div>

              <p className="mt-7 text-sm font-medium text-[#f43f72]">
                SHE Finds
              </p>

              <h1 className="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.04em] md:text-6xl">
                Find the right product for you
              </h1>

              <p className="mt-5 max-w-2xl text-base leading-7 text-stone-600 md:text-lg">
                Compare women’s-health products by effectiveness,
                comfort, practicality and accessibility before deciding
                where to buy.
              </p>

              <div className="relative mt-8 max-w-3xl">
                <Search
                  size={20}
                  className="absolute left-5 top-1/2 -translate-y-1/2 text-stone-400"
                />

                <input
                  value={search}
                  onChange={(event) => {
                    setSearch(event.target.value);
                    setShowCatalogue(true);
                  }}
                  placeholder="Search products, brands or health needs..."
                  className="h-16 w-full rounded-2xl border border-[#efdde2] bg-white pl-14 pr-5 text-sm shadow-[0_10px_30px_rgba(63,39,47,0.05)] outline-none transition placeholder:text-stone-400 focus:border-[#f4a8bd]"
                />
              </div>

              <div className="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-xs text-stone-500">
                <span className="flex items-center gap-2">
                  <CheckCircle2 size={15} className="text-[#f43f72]" />
                  {productCount}+ curated products
                </span>

                <span className="flex items-center gap-2">
                  <CheckCircle2 size={15} className="text-[#f43f72]" />
                  Evidence-aware explanations
                </span>

                <span className="flex items-center gap-2">
                  <CheckCircle2 size={15} className="text-[#f43f72]" />
                  Compare before buying
                </span>
              </div>
            </div>

            <div className="grid grid-cols-2 gap-4">
              <button
                type="button"
                onClick={() => {
                  setShowSavedOnly((value) => !value);
                  setShowCatalogue(true);
                }}
                className={`rounded-[24px] border p-5 text-left shadow-sm transition ${
                  showSavedOnly
                    ? "border-[#f43f72] bg-[#fff1f5]"
                    : "border-white bg-white/85 hover:border-[#f4c4d2]"
                }`}
              >
                <Heart
                  size={21}
                  className={
                    showSavedOnly
                      ? "fill-current text-[#f43f72]"
                      : "text-[#f43f72]"
                  }
                />
                <p className="mt-7 text-xs text-stone-500">
                  Saved products
                </p>
                <p className="mt-1 text-2xl font-semibold">
                  {savedIds.length}
                </p>
              </button>

              <button
                type="button"
                onClick={() => {
                  setShowCatalogue(true);
                  setSort("Highest SHE Score");
                }}
                className="rounded-[24px] border border-white bg-white/85 p-5 text-left shadow-sm transition hover:border-[#f4c4d2]"
              >
                <Sparkles size={21} className="text-[#f43f72]" />
                <p className="mt-7 text-xs text-stone-500">
                  SHE reviewed
                </p>
                <p className="mt-1 text-2xl font-semibold">
                  {productCount}
                </p>
              </button>
            </div>
          </div>
        </header>

        <section className="mt-14">
          <div>
            <p className="text-sm font-medium text-[#f43f72]">
              Shop by need
            </p>
            <h2 className="mt-2 text-3xl font-semibold tracking-tight">
              What are you looking for?
            </h2>
          </div>

          <div className="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {productCategories.map((item) => {
              const count = products.filter(
                (product) => product.category === item.name,
              ).length;

              return (
                <button
                  key={item.name}
                  type="button"
                  onClick={() => {
                    setCategory(item.name);
                    setShowCatalogue(true);
                    requestAnimationFrame(() => {
                      document
                        .getElementById("all-products")
                        ?.scrollIntoView({
                          behavior: "smooth",
                          block: "start",
                        });
                    });
                  }}
                  className="group rounded-[24px] border border-[#f2e3e7] bg-white p-5 text-left shadow-[0_8px_25px_rgba(63,39,47,0.035)] transition hover:-translate-y-1 hover:border-[#f4b7c8]"
                >
                  <div className="flex items-start justify-between">
                    <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#fff1f5] text-lg font-semibold text-[#f43f72]">
                      {item.icon}
                    </div>

                    <ChevronRight
                      size={18}
                      className="text-stone-300 transition group-hover:translate-x-1 group-hover:text-[#f43f72]"
                    />
                  </div>

                  <h3 className="mt-7 font-semibold">{item.name}</h3>

                  <p className="mt-2 min-h-10 text-xs leading-5 text-stone-500">
                    {item.description}
                  </p>

                  <p className="mt-4 text-xs font-medium text-[#e93368]">
                    {count} products
                  </p>
                </button>
              );
            })}
          </div>
        </section>

        {!catalogueVisible && (
          <>
            <ProductRow
              title="SHE recommends"
              description="Strong scores across usability, practicality and evidence."
              items={featuredProducts}
              handlers={handlers}
            />

            <ProductRow
              title="Popular right now"
              description="Products being considered across period, pregnancy and everyday health."
              items={popularProducts}
              handlers={handlers}
            />

            <ProductRow
              title="Under £15"
              description="Useful, accessible options without a premium price."
              items={underFifteen}
              handlers={handlers}
            />

            <ProductRow
              title="Reusable favourites"
              description="Longer-lasting products that may reduce repeat purchases."
              items={reusableProducts}
              handlers={handlers}
            />

            <section className="mt-16 rounded-[30px] bg-[#211d1f] px-6 py-9 text-white md:px-10">
              <div className="flex flex-col justify-between gap-7 md:flex-row md:items-center">
                <div>
                  <p className="text-sm font-medium text-[#ff9fbb]">
                    Compare before you buy
                  </p>
                  <h2 className="mt-2 text-3xl font-semibold tracking-tight">
                    Not sure which product suits you?
                  </h2>
                  <p className="mt-3 max-w-2xl text-sm leading-6 text-white/65">
                    Add up to three products and compare price,
                    suitability, evidence, strengths and limitations.
                  </p>
                </div>

                <button
                  type="button"
                  onClick={() => {
                    setShowCatalogue(true);
                    document
                      .getElementById("all-products")
                      ?.scrollIntoView({ behavior: "smooth" });
                  }}
                  className="flex w-fit items-center gap-2 rounded-xl bg-white px-5 py-3.5 text-sm font-medium text-[#211d1f]"
                >
                  Browse all products
                  <ArrowRight size={17} />
                </button>
              </div>
            </section>
          </>
        )}

        <section id="all-products" className="scroll-mt-6 pt-16">
          <div className="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
            <div>
              <p className="text-sm font-medium text-[#f43f72]">
                Full catalogue
              </p>

              <h2 className="mt-2 text-3xl font-semibold tracking-tight">
                {showSavedOnly
                  ? "Your saved products"
                  : category === "All"
                    ? "All products"
                    : category}
              </h2>

              <p className="mt-2 text-sm text-stone-500">
                {filteredProducts.length} products match your selection.
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-3">
              <button
                type="button"
                onClick={() => setShowFilters((value) => !value)}
                className={`flex items-center gap-2 rounded-xl border px-4 py-3 text-sm font-medium ${
                  showFilters
                    ? "border-[#f43f72] bg-[#fff1f5] text-[#e93368]"
                    : "border-stone-200 bg-white text-stone-600"
                }`}
              >
                <SlidersHorizontal size={16} />
                Filters
              </button>

              <select
                value={sort}
                onChange={(event) => setSort(event.target.value)}
                className="rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm text-stone-600 outline-none"
              >
                <option>Recommended</option>
                <option>Highest SHE Score</option>
                <option>Price: low to high</option>
                <option>Price: high to low</option>
                <option>Most popular</option>
                <option>Newest</option>
              </select>
            </div>
          </div>

          <div className="mt-7 flex gap-3 overflow-x-auto pb-2">
            {["All", ...productCategories.map((item) => item.name)].map(
              (item) => (
                <button
                  key={item}
                  type="button"
                  onClick={() => {
                    setCategory(item);
                    setShowCatalogue(true);
                  }}
                  className={`whitespace-nowrap rounded-full border px-4 py-2.5 text-sm transition ${
                    category === item
                      ? "border-[#211d1f] bg-[#211d1f] text-white"
                      : "border-stone-200 bg-white text-stone-600 hover:border-[#f4b7c8]"
                  }`}
                >
                  {item}
                </button>
              ),
            )}
          </div>

          {showFilters && (
            <div className="mt-6 grid gap-6 rounded-[24px] border border-[#f1e3e7] bg-white p-6 md:grid-cols-3">
              <label>
                <span className="text-sm font-medium">
                  Maximum price: {currencyFormatter.format(maxPrice)}
                </span>

                <input
                  type="range"
                  min="5"
                  max="300"
                  step="5"
                  value={maxPrice}
                  onChange={(event) =>
                    setMaxPrice(Number(event.target.value))
                  }
                  className="mt-4 w-full accent-[#f43f72]"
                />
              </label>

              <label>
                <span className="text-sm font-medium">
                  Minimum SHE Score
                </span>

                <select
                  value={minimumScore}
                  onChange={(event) =>
                    setMinimumScore(Number(event.target.value))
                  }
                  className="mt-3 w-full rounded-xl border border-stone-200 px-4 py-3 text-sm outline-none"
                >
                  <option value="0">Any score</option>
                  <option value="7">7.0 and above</option>
                  <option value="8">8.0 and above</option>
                  <option value="8.5">8.5 and above</option>
                </select>
              </label>

              <label className="flex cursor-pointer items-center gap-3 rounded-xl bg-stone-50 px-4 py-3">
                <input
                  type="checkbox"
                  checked={reusableOnly}
                  onChange={(event) =>
                    setReusableOnly(event.target.checked)
                  }
                  className="h-4 w-4 accent-[#f43f72]"
                />

                <div>
                  <p className="text-sm font-medium">
                    Reusable products only
                  </p>
                  <p className="mt-1 text-xs text-stone-400">
                    Hide single-use products
                  </p>
                </div>
              </label>
            </div>
          )}

          {filteredProducts.length > 0 ? (
            <div className="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
              {filteredProducts.map((product) => (
                <ProductCard
                  key={product.id}
                  product={product}
                  {...handlers(product)}
                />
              ))}
            </div>
          ) : (
            <div className="mt-8 rounded-[26px] border border-dashed border-stone-200 py-20 text-center">
              <Search
                size={28}
                className="mx-auto text-stone-300"
              />
              <h3 className="mt-5 text-lg font-semibold">
                No products found
              </h3>
              <p className="mt-2 text-sm text-stone-500">
                Try changing your search or filters.
              </p>

              <button
                type="button"
                onClick={() => {
                  setSearch("");
                  setCategory("All");
                  setMaxPrice(300);
                  setMinimumScore(0);
                  setReusableOnly(false);
                  setShowSavedOnly(false);
                }}
                className="mt-5 text-sm font-medium text-[#e93368]"
              >
                Clear all filters
              </button>
            </div>
          )}
        </section>

        <section className="mt-16 rounded-[26px] border border-[#f1e3e7] bg-[#fff8fa] p-6 md:p-8">
          <div className="flex gap-4">
            <ShieldCheck
              size={22}
              className="mt-0.5 shrink-0 text-[#f43f72]"
            />

            <div>
              <h2 className="font-semibold text-[#211d1f]">
                Shopping information you can question
              </h2>
              <p className="mt-2 max-w-4xl text-sm leading-6 text-stone-600">
                SHE Scores are editorial comparison tools, not medical
                endorsements. Products are assessed across evidence,
                ease of use, comfort, practicality and accessibility.
                Prices and availability shown in this MVP are
                demonstration data and must be connected to live
                retailer feeds before launch.
              </p>
            </div>
          </div>
        </section>
      </main>

      {selectedProduct && (
        <DetailModal
          product={selectedProduct}
          isSaved={savedIds.includes(selectedProduct.id)}
          isCompared={compareIds.includes(selectedProduct.id)}
          onClose={() => setSelectedProduct(null)}
          onSave={toggleSaved}
          onCompare={toggleCompare}
        />
      )}

      <CompareDrawer
        products={comparedProducts}
        onRemove={(id) =>
          setCompareIds((current) =>
            current.filter((item) => item !== id),
          )
        }
        onClear={() => setCompareIds([])}
        onOpen={setSelectedProduct}
      />
    </div>
  );
}
