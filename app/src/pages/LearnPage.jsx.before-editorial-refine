import { useEffect, useMemo, useState } from "react";
import { AnimatePresence, motion } from "framer-motion";
import {
  ArrowLeft,
  Bookmark,
  Check,
  ChevronRight,
  Clock3,
  Search,
  Stethoscope,
  X,
} from "lucide-react";
import {
  getCategoryById,
  getGuideById,
  learnCategories,
  learnGuides,
} from "../data/learnContent";

const STORAGE_KEYS = {
  saved: "she-learn-saved",
  recent: "she-learn-recent",
  progress: "she-learn-progress",
};

function readStorage(key, fallback) {
  try {
    const value = window.localStorage.getItem(key);
    return value ? JSON.parse(value) : fallback;
  } catch {
    return fallback;
  }
}

export default function LearnPage() {
  const [query, setQuery] = useState("");
  const [selectedCategoryId, setSelectedCategoryId] = useState(null);
  const [selectedGuideId, setSelectedGuideId] = useState(null);

  const [savedIds, setSavedIds] = useState(() =>
    readStorage(STORAGE_KEYS.saved, []),
  );

  const [recentIds, setRecentIds] = useState(() =>
    readStorage(STORAGE_KEYS.recent, []),
  );

  const [progress, setProgress] = useState(() =>
    readStorage(STORAGE_KEYS.progress, {}),
  );

  const selectedCategory = selectedCategoryId
    ? getCategoryById(selectedCategoryId)
    : null;

  const selectedGuide = selectedGuideId
    ? getGuideById(selectedGuideId)
    : null;

  useEffect(() => {
    window.localStorage.setItem(
      STORAGE_KEYS.saved,
      JSON.stringify(savedIds),
    );
  }, [savedIds]);

  useEffect(() => {
    window.localStorage.setItem(
      STORAGE_KEYS.recent,
      JSON.stringify(recentIds),
    );
  }, [recentIds]);

  useEffect(() => {
    window.localStorage.setItem(
      STORAGE_KEYS.progress,
      JSON.stringify(progress),
    );
  }, [progress]);

  /*
    Opens guides selected from Chat, Symptoms or Body Explorer.
  */
  useEffect(() => {
    try {
      const stored = window.localStorage.getItem(
        "she-intelligence-guide-target",
      );

      if (!stored) return;

      const target = JSON.parse(stored);
      const guide = getGuideById(target.id);

      if (guide) {
        setSelectedCategoryId(guide.category);
        setSelectedGuideId(guide.id);
        recordGuideOpen(guide);
      }

      window.localStorage.removeItem(
        "she-intelligence-guide-target",
      );
    } catch {
      window.localStorage.removeItem(
        "she-intelligence-guide-target",
      );
    }
  }, []);

  const searchResults = useMemo(() => {
    const search = query.trim().toLowerCase();

    if (!search) return [];

    return learnGuides.filter((guide) => {
      const content = [
        guide.title,
        guide.subtitle,
        guide.categoryLabel,
        guide.summary,
        guide.overview,
        ...(guide.tags || []),
        ...(guide.keyPoints || []),
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return content.includes(search);
    });
  }, [query]);

  const categoryGuides = useMemo(() => {
    if (!selectedCategoryId) return [];

    return learnGuides
      .filter((guide) => guide.category === selectedCategoryId)
      .sort((a, b) => a.title.localeCompare(b.title));
  }, [selectedCategoryId]);

  function recordGuideOpen(guide) {
    setRecentIds((current) => [
      guide.id,
      ...current.filter((id) => id !== guide.id),
    ].slice(0, 8));

    setProgress((current) => ({
      ...current,
      [guide.id]: Math.max(current[guide.id] || 0, 20),
    }));
  }

  function openCategory(categoryId) {
    setSelectedCategoryId(categoryId);
    setSelectedGuideId(null);
    setQuery("");

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  function openGuide(guide) {
    setSelectedCategoryId(guide.category);
    setSelectedGuideId(guide.id);
    recordGuideOpen(guide);

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  function returnToIndex() {
    setSelectedCategoryId(null);
    setSelectedGuideId(null);
    setQuery("");

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  function returnToCategory() {
    setSelectedGuideId(null);

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  function toggleSaved(guideId) {
    setSavedIds((current) =>
      current.includes(guideId)
        ? current.filter((id) => id !== guideId)
        : [guideId, ...current],
    );
  }

  function markComplete(guideId) {
    setProgress((current) => ({
      ...current,
      [guideId]: 100,
    }));
  }

  if (selectedGuide) {
    return (
      <GuidePage
        guide={selectedGuide}
        saved={savedIds.includes(selectedGuide.id)}
        progress={progress[selectedGuide.id] || 0}
        onBack={returnToCategory}
        onHome={returnToIndex}
        onToggleSaved={() => toggleSaved(selectedGuide.id)}
        onComplete={() => markComplete(selectedGuide.id)}
        onOpenGuide={openGuide}
      />
    );
  }

  if (selectedCategory) {
    return (
      <CategoryPage
        category={selectedCategory}
        guides={categoryGuides}
        savedIds={savedIds}
        progress={progress}
        onBack={returnToIndex}
        onOpenGuide={openGuide}
        onToggleSaved={toggleSaved}
      />
    );
  }

  return (
    <main className="mx-auto w-full max-w-5xl px-5 pb-32 pt-10 md:px-10">
      <header className="border-b border-stone-100 pb-9">
        <p className="text-sm font-medium text-[#f43f72]">
          SHE Learn
        </p>

        <h1 className="mt-3 text-4xl font-semibold tracking-tight text-[#241f20] md:text-6xl">
          Women’s health topics
        </h1>

        <p className="mt-4 max-w-2xl text-base leading-7 text-stone-500">
          Browse clear, practical information by health topic or search
          for a condition or symptom.
        </p>

        <label className="mt-8 flex max-w-2xl items-center gap-3 rounded-2xl border border-stone-200 bg-white px-4 py-4 transition focus-within:border-pink-300 focus-within:ring-4 focus-within:ring-pink-100">
          <Search size={20} className="shrink-0 text-stone-400" />

          <input
            value={query}
            onChange={(event) => setQuery(event.target.value)}
            placeholder="Search a condition or symptom..."
            className="w-full bg-transparent text-sm outline-none placeholder:text-stone-400 md:text-base"
          />

          {query && (
            <button
              type="button"
              onClick={() => setQuery("")}
              className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-500"
            >
              <X size={15} />
            </button>
          )}
        </label>
      </header>

      {query ? (
        <section className="pt-9">
          <div className="flex items-end justify-between gap-4">
            <div>
              <p className="text-sm text-[#f43f72]">
                Search results
              </p>

              <h2 className="mt-2 text-2xl font-semibold">
                Results for “{query}”
              </h2>
            </div>

            <p className="text-sm text-stone-400">
              {searchResults.length}
            </p>
          </div>

          {searchResults.length > 0 ? (
            <div className="mt-6 border-t border-stone-100">
              {searchResults.map((guide) => (
                <GuideListRow
                  key={guide.id}
                  guide={guide}
                  saved={savedIds.includes(guide.id)}
                  progress={progress[guide.id] || 0}
                  onOpen={() => openGuide(guide)}
                  onToggleSaved={() => toggleSaved(guide.id)}
                />
              ))}
            </div>
          ) : (
            <div className="mt-8 py-12 text-center">
              <p className="text-lg font-medium">
                No matching topic yet
              </p>

              <p className="mt-2 text-sm text-stone-500">
                Try a broader condition, symptom or health area.
              </p>
            </div>
          )}
        </section>
      ) : (
        <>
          <section className="pt-9">
            <div className="border-t border-stone-100">
              {learnCategories.map((category) => {
                const guideCount = learnGuides.filter(
                  (guide) => guide.category === category.id,
                ).length;

                return (
                  <button
                    key={category.id}
                    type="button"
                    onClick={() => openCategory(category.id)}
                    className="group flex w-full items-center justify-between gap-6 border-b border-stone-100 py-6 text-left transition hover:pl-2"
                  >
                    <div>
                      <h2 className="text-xl font-medium text-[#241f20] transition group-hover:text-[#f43f72] md:text-2xl">
                        {category.name}
                      </h2>

                      <p className="mt-2 text-sm leading-6 text-stone-500">
                        {category.description}
                      </p>
                    </div>

                    <div className="flex shrink-0 items-center gap-3">
                      <span className="hidden text-xs text-stone-400 sm:block">
                        {guideCount}{" "}
                        {guideCount === 1 ? "topic" : "topics"}
                      </span>

                      <ChevronRight
                        size={20}
                        className="text-stone-300 transition group-hover:translate-x-1 group-hover:text-[#f43f72]"
                      />
                    </div>
                  </button>
                );
              })}
            </div>
          </section>

          {(recentIds.length > 0 || savedIds.length > 0) && (
            <section className="mt-14 grid gap-10 border-t border-stone-100 pt-10 md:grid-cols-2">
              {recentIds.length > 0 && (
                <SmallList
                  title="Recently viewed"
                  guides={recentIds
                    .map(getGuideById)
                    .filter(Boolean)
                    .slice(0, 4)}
                  onOpenGuide={openGuide}
                />
              )}

              {savedIds.length > 0 && (
                <SmallList
                  title="Saved topics"
                  guides={savedIds
                    .map(getGuideById)
                    .filter(Boolean)
                    .slice(0, 4)}
                  onOpenGuide={openGuide}
                />
              )}
            </section>
          )}
        </>
      )}

      <p className="mt-14 border-t border-stone-100 pt-6 text-xs leading-5 text-stone-400">
        SHE Learn provides general educational information and does not
        diagnose conditions or replace individual medical advice.
      </p>
    </main>
  );
}

function CategoryPage({
  category,
  guides,
  savedIds,
  progress,
  onBack,
  onOpenGuide,
  onToggleSaved,
}) {
  const [query, setQuery] = useState("");

  const filteredGuides = useMemo(() => {
    const search = query.trim().toLowerCase();

    if (!search) return guides;

    return guides.filter((guide) =>
      [
        guide.title,
        guide.subtitle,
        guide.summary,
        ...(guide.tags || []),
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase()
        .includes(search),
    );
  }, [guides, query]);

  return (
    <main className="mx-auto w-full max-w-5xl px-5 pb-32 pt-10 md:px-10">
      <button
        type="button"
        onClick={onBack}
        className="flex items-center gap-2 text-sm font-medium text-stone-500 transition hover:text-[#f43f72]"
      >
        <ArrowLeft size={17} />
        All health topics
      </button>

      <header className="mt-9 border-b border-stone-100 pb-8">
        <p className="text-sm font-medium text-[#f43f72]">
          SHE Learn
        </p>

        <h1 className="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">
          {category.name}
        </h1>

        <p className="mt-4 max-w-2xl text-base leading-7 text-stone-500">
          {category.description}
        </p>

        <label className="mt-7 flex max-w-xl items-center gap-3 rounded-2xl border border-stone-200 px-4 py-3.5 focus-within:border-pink-300 focus-within:ring-4 focus-within:ring-pink-100">
          <Search size={19} className="text-stone-400" />

          <input
            value={query}
            onChange={(event) => setQuery(event.target.value)}
            placeholder={`Search ${category.name.toLowerCase()}...`}
            className="w-full bg-transparent text-sm outline-none"
          />

          {query && (
            <button type="button" onClick={() => setQuery("")}>
              <X size={15} className="text-stone-400" />
            </button>
          )}
        </label>
      </header>

      <section>
        <div className="border-t border-stone-100">
          {filteredGuides.map((guide) => (
            <GuideListRow
              key={guide.id}
              guide={guide}
              saved={savedIds.includes(guide.id)}
              progress={progress[guide.id] || 0}
              onOpen={() => onOpenGuide(guide)}
              onToggleSaved={() => onToggleSaved(guide.id)}
            />
          ))}
        </div>

        {filteredGuides.length === 0 && (
          <div className="py-14 text-center">
            <p className="font-medium">No matching topic</p>
            <p className="mt-2 text-sm text-stone-500">
              Try another search term.
            </p>
          </div>
        )}
      </section>
    </main>
  );
}

function GuideListRow({
  guide,
  saved,
  progress,
  onOpen,
  onToggleSaved,
}) {
  return (
    <div className="group flex items-center gap-4 border-b border-stone-100 py-6">
      <button
        type="button"
        onClick={onOpen}
        className="min-w-0 flex-1 text-left"
      >
        <div className="flex items-center gap-2 text-xs text-stone-400">
          <Clock3 size={13} />
          {guide.readTime} minute read
          {progress === 100 && (
            <>
              <span>·</span>
              <span className="text-emerald-600">Completed</span>
            </>
          )}
        </div>

        <h3 className="mt-2 text-xl font-medium transition group-hover:text-[#f43f72] md:text-2xl">
          {guide.title}
        </h3>

        {guide.subtitle && (
          <p className="mt-1 text-sm text-stone-400">
            {guide.subtitle}
          </p>
        )}

        <p className="mt-2 max-w-3xl text-sm leading-6 text-stone-500">
          {guide.summary}
        </p>
      </button>

      <button
        type="button"
        onClick={onToggleSaved}
        className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full transition ${
          saved
            ? "bg-pink-50 text-[#f43f72]"
            : "text-stone-300 hover:bg-pink-50 hover:text-[#f43f72]"
        }`}
        aria-label={saved ? "Remove saved topic" : "Save topic"}
      >
        <Bookmark
          size={17}
          fill={saved ? "currentColor" : "none"}
        />
      </button>

      <button
        type="button"
        onClick={onOpen}
        className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-stone-300 transition group-hover:text-[#f43f72]"
      >
        <ChevronRight size={20} />
      </button>
    </div>
  );
}

function GuidePage({
  guide,
  saved,
  progress,
  onBack,
  onHome,
  onToggleSaved,
  onComplete,
  onOpenGuide,
}) {
  const relatedGuides = learnGuides
    .filter(
      (candidate) =>
        candidate.category === guide.category &&
        candidate.id !== guide.id,
    )
    .slice(0, 5);

  return (
    <main className="mx-auto w-full max-w-4xl px-5 pb-32 pt-10 md:px-10">
      <nav className="flex flex-wrap items-center gap-3 text-sm">
        <button
          type="button"
          onClick={onHome}
          className="text-stone-400 hover:text-[#f43f72]"
        >
          Learn
        </button>

        <ChevronRight size={14} className="text-stone-300" />

        <button
          type="button"
          onClick={onBack}
          className="text-stone-500 hover:text-[#f43f72]"
        >
          {guide.categoryLabel}
        </button>
      </nav>

      <article className="mt-10">
        <header className="border-b border-stone-100 pb-9">
          <p className="text-sm font-medium text-[#f43f72]">
            {guide.categoryLabel}
          </p>

          <h1 className="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">
            {guide.title}
          </h1>

          {guide.subtitle && (
            <p className="mt-3 text-lg text-stone-500">
              {guide.subtitle}
            </p>
          )}

          <div className="mt-6 flex flex-wrap items-center gap-4 text-sm text-stone-500">
            <span className="flex items-center gap-2">
              <Clock3 size={16} />
              {guide.readTime} minute read
            </span>

            <span>{guide.level}</span>

            <button
              type="button"
              onClick={onToggleSaved}
              className={`flex items-center gap-2 ${
                saved
                  ? "text-[#f43f72]"
                  : "text-stone-500 hover:text-[#f43f72]"
              }`}
            >
              <Bookmark
                size={16}
                fill={saved ? "currentColor" : "none"}
              />
              {saved ? "Saved" : "Save"}
            </button>
          </div>
        </header>

        <ContentSection title={`What is ${guide.title}?`}>
          <p>{guide.overview}</p>
        </ContentSection>

        <ContentSection title="Key things to know">
          <SimpleBulletList items={guide.keyPoints} />
        </ContentSection>

        <ContentSection
          title="When to seek medical advice"
          icon={Stethoscope}
        >
          <SimpleBulletList items={guide.seekHelp} />

          <p className="mt-5 text-sm text-stone-500">
            Seek urgent medical assistance for severe, sudden or
            life-threatening symptoms.
          </p>
        </ContentSection>

        <ContentSection title="Questions for your clinician">
          <ol className="space-y-4">
            {guide.questions.map((question, index) => (
              <li
                key={question}
                className="flex items-start gap-4 text-base leading-7 text-stone-700"
              >
                <span className="mt-0.5 text-sm font-medium text-[#f43f72]">
                  {String(index + 1).padStart(2, "0")}
                </span>

                {question}
              </li>
            ))}
          </ol>
        </ContentSection>

        <section className="mt-12 flex flex-col gap-3 border-y border-stone-100 py-7 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p className="font-medium">
              {progress === 100
                ? "You have completed this guide"
                : "Finished reading?"}
            </p>

            <p className="mt-1 text-sm text-stone-500">
              Marking it complete saves your reading progress.
            </p>
          </div>

          <button
            type="button"
            onClick={onComplete}
            className={`flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-medium ${
              progress === 100
                ? "bg-emerald-50 text-emerald-700"
                : "bg-[#241f20] text-white"
            }`}
          >
            <Check size={17} />
            {progress === 100 ? "Completed" : "Mark complete"}
          </button>
        </section>

        {relatedGuides.length > 0 && (
          <section className="mt-12">
            <h2 className="text-2xl font-semibold">
              More in {guide.categoryLabel}
            </h2>

            <div className="mt-5 border-t border-stone-100">
              {relatedGuides.map((relatedGuide) => (
                <button
                  key={relatedGuide.id}
                  type="button"
                  onClick={() => onOpenGuide(relatedGuide)}
                  className="group flex w-full items-center justify-between gap-5 border-b border-stone-100 py-5 text-left"
                >
                  <div>
                    <p className="text-lg font-medium group-hover:text-[#f43f72]">
                      {relatedGuide.title}
                    </p>

                    <p className="mt-1 text-sm text-stone-500">
                      {relatedGuide.readTime} minute read
                    </p>
                  </div>

                  <ChevronRight
                    size={19}
                    className="shrink-0 text-stone-300 group-hover:text-[#f43f72]"
                  />
                </button>
              ))}
            </div>
          </section>
        )}

        <p className="mt-12 border-t border-stone-100 pt-6 text-xs leading-5 text-stone-400">
          This guide provides general educational information and does
          not diagnose conditions or replace individual medical advice.
          Clinical content should be independently reviewed before public
          release.
        </p>
      </article>
    </main>
  );
}

function ContentSection({ title, icon: Icon, children }) {
  return (
    <section className="border-b border-stone-100 py-10">
      <div className="flex items-center gap-3">
        {Icon && <Icon size={20} className="text-[#f43f72]" />}

        <h2 className="text-2xl font-semibold">{title}</h2>
      </div>

      <div className="mt-5 text-base leading-8 text-stone-600">
        {children}
      </div>
    </section>
  );
}

function SimpleBulletList({ items = [] }) {
  return (
    <ul className="space-y-4">
      {items.map((item) => (
        <li
          key={item}
          className="flex items-start gap-4"
        >
          <span className="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#f43f72]" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  );
}

function SmallList({ title, guides, onOpenGuide }) {
  return (
    <div>
      <h2 className="text-lg font-medium">{title}</h2>

      <div className="mt-4 border-t border-stone-100">
        {guides.map((guide) => (
          <button
            key={guide.id}
            type="button"
            onClick={() => onOpenGuide(guide)}
            className="flex w-full items-center justify-between gap-4 border-b border-stone-100 py-4 text-left"
          >
            <div>
              <p className="font-medium">{guide.title}</p>

              <p className="mt-1 text-xs text-stone-400">
                {guide.categoryLabel}
              </p>
            </div>

            <ChevronRight
              size={17}
              className="shrink-0 text-stone-300"
            />
          </button>
        ))}
      </div>
    </div>
  );
}
