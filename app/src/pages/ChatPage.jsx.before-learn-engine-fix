function formatSHEKnowledgeResponse(response) {
  const parts = [];

  if (response.urgentWarning) {
    parts.push(
      `⚠️ Urgent safety information\n${response.urgentWarning}\n\n` +
      "Seek urgent medical care when symptoms are severe, sudden or life-threatening."
    );
  }

  if (response.title) {
    parts.push(response.title);
  }

  if (response.introduction) {
    parts.push(response.introduction);
  }

  (response.sections || []).forEach((section) => {
    const sectionParts = [];

    if (section.title) {
      sectionParts.push(section.title);
    }

    if (section.text) {
      sectionParts.push(section.text);
    }

    if (section.items?.length) {
      sectionParts.push(
        section.items.map((item) => `• ${item}`).join("\n")
      );
    }

    if (section.comparisons?.length) {
      sectionParts.push(
        section.comparisons
          .map((comparison) => {
            const points = (comparison.keyPoints || [])
              .map((point) => `• ${point}`)
              .join("\n");

            return [
              comparison.title,
              comparison.text,
              points,
            ]
              .filter(Boolean)
              .join("\n");
          })
          .join("\n\n")
      );
    }

    if (sectionParts.length) {
      parts.push(sectionParts.join("\n\n"));
    }
  });

  if (response.relatedGuides?.length) {
    parts.push(
      [
        "Related SHE Learn guides",
        ...response.relatedGuides.map(
          (guide) =>
            `• ${guide.title} — ${guide.readTime} min read`
        ),
      ].join("\n")
    );
  }

  if (response.disclaimer) {
    parts.push(response.disclaimer);
  }

  return parts.filter(Boolean).join("\n\n");
}

const topics = [
  {
    title: "Painful periods",
    prompt: "Why are my periods so painful?",
    icon: Droplets,
  },
  {
    title: "Endometriosis",
    prompt: "Could I have endometriosis?",
    icon: Flower2,
  },
  {
    title: "Trying to conceive",
    prompt: "What should I know about trying to conceive?",
    icon: Baby,
  },
  {
    title: "Contraception options",
    prompt: "Help me compare contraception options.",
    icon: Pill,
  },
  {
    title: "Autoimmune diseases",
    prompt: "How can autoimmune diseases affect women’s health?",
    icon: ShieldPlus,
  },
];

export default function ChatPage({
  conversation,
  setConversation,
  saveConversation,
}) {
  const [message, setMessage] = useState("");
  const [isThinking, setIsThinking] = useState(false);
  const [streamingText, setStreamingText] = useState("");
  const endRef = useRef(null);

  const hasConversation = conversation.length > 0;

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [conversation, isThinking, streamingText]);

  function submitMessage(event) {
    event.preventDefault();

    const cleanMessage = message.trim();
    if (!cleanMessage || isThinking) return;

    const userMessage = {
      id: Date.now(),
      role: "user",
      text: cleanMessage,
    };

    setConversation((current) => [...current, userMessage]);
    setMessage("");
    setIsThinking(true);

    window.setTimeout(() => {
      streamResponse(createResponse(cleanMessage), cleanMessage);
    }, 650);
  }

  function streamResponse(fullResponse, originalQuestion) {
    setIsThinking(false);
    setStreamingText("");

    let position = 0;

    const interval = window.setInterval(() => {
      position += 3;
      setStreamingText(fullResponse.slice(0, position));

      if (position >= fullResponse.length) {
        window.clearInterval(interval);

        const completedMessage = {
          id: Date.now() + 1,
          role: "she",
          text: fullResponse,
        };

        setConversation((current) => {
          const updated = [...current, completedMessage];
          saveConversation(originalQuestion, updated);
          return updated;
        });

        setStreamingText("");
      }
    }, 12);
  }

  function chooseSuggestion(suggestion) {
    setMessage(suggestion);

    window.setTimeout(() => {
      document.querySelector("#she-message-input")?.focus();
    }, 50);
  }

  return (
    <main className="mx-auto w-full max-w-6xl px-5 pb-32 pt-4 md:px-8 lg:px-12">
      {!hasConversation && !streamingText && (
        <>
          <section className="pt-8 text-center md:pt-14">
            <h2 className="mx-auto max-w-3xl text-4xl font-semibold leading-tight tracking-tight md:text-6xl">
              How can SHE help today?
            </h2>

            <p className="mx-auto mt-4 max-w-xl text-base text-stone-500 md:text-xl">
              Your health, your questions, your next step.
            </p>
          </section>

          <div className="mt-9">
            <ChatComposer
              message={message}
              setMessage={setMessage}
              submitMessage={submitMessage}
              disabled={isThinking}
            />
          </div>

          <section className="mx-auto mt-12 w-full max-w-5xl">
            <div className="mb-7 flex items-center justify-center gap-4">
              <div className="h-px w-16 bg-pink-100 md:w-28" />
              <h3 className="text-lg font-semibold md:text-xl">
                Popular topics
              </h3>
              <div className="h-px w-16 bg-pink-100 md:w-28" />
            </div>

            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
              {topics.map(({ title, prompt, icon: Icon }) => (
                <button
                  key={title}
                  type="button"
                  onClick={() => chooseSuggestion(prompt)}
                  className="group flex min-h-44 flex-col items-center justify-between rounded-3xl border border-pink-100 bg-white px-5 py-6 text-center shadow-sm transition hover:-translate-y-1 hover:border-pink-200 hover:shadow-lg"
                >
                  <div className="flex h-14 w-14 items-center justify-center rounded-full bg-pink-50 text-[#f43f72] transition group-hover:bg-pink-100">
                    <Icon size={27} />
                  </div>

                  <p className="mt-5 text-base font-medium leading-snug">
                    {title}
                  </p>

                  <span className="mt-5 text-sm text-[#f43f72]">Ask SHE →</span>
                </button>
              ))}
            </div>
          </section>
        </>
      )}

      {(hasConversation || streamingText) && (
        <section className="mx-auto max-w-3xl pb-8 pt-3">
          <div className="mb-7">
            <p className="text-sm font-medium text-[#f43f72]">
              SHE Health Navigator
            </p>
            <h2 className="mt-1 text-2xl font-semibold">Your conversation</h2>
          </div>

          <div className="space-y-6">
            {conversation.map((entry, index) => (
              <ChatMessage
                key={entry.id}
                message={entry}
                suggestions={
                  entry.role === "she" &&
                  index === conversation.length - 1
                    ? getSuggestions(entry.text)
                    : []
                }
                chooseSuggestion={chooseSuggestion}
              />
            ))}

            {isThinking && (
              <div className="flex justify-start">
                <div className="rounded-3xl rounded-bl-lg border border-pink-100 bg-white px-5 py-4 shadow-sm">
                  <div className="flex items-center gap-3">
                    <img
                      src="/logo.png"
                      alt=""
                      className="h-7 w-7 rounded-full object-cover"
                    />

                    <div className="flex gap-1">
                      <span className="h-2 w-2 animate-bounce rounded-full bg-pink-300" />
                      <span className="h-2 w-2 animate-bounce rounded-full bg-pink-400 [animation-delay:150ms]" />
                      <span className="h-2 w-2 animate-bounce rounded-full bg-pink-500 [animation-delay:300ms]" />
                    </div>
                  </div>
                </div>
              </div>
            )}

            {streamingText && (
              <ChatMessage
                message={{
                  id: "streaming",
                  role: "she",
                  text: streamingText,
                }}
                suggestions={[]}
                chooseSuggestion={chooseSuggestion}
              />
            )}

            <div ref={endRef} />
          </div>

          <div className="sticky bottom-24 z-20 mt-8">
            <ChatComposer
              message={message}
              setMessage={setMessage}
              submitMessage={submitMessage}
              disabled={isThinking || Boolean(streamingText)}
              compact
            />
          </div>
        </section>
      )}
    </main>
  );
}

function getSuggestions(text) {
  const lower = text.toLowerCase();

  if (lower.includes("period")) {
    return [
      "Help me prepare for a GP appointment",
      "What symptoms should I track?",
      "Could this be endometriosis?",
    ];
  }

  if (lower.includes("fertility")) {
    return [
      "When should I seek fertility advice?",
      "What happens during an assessment?",
      "How should I track my cycle?",
    ];
  }

  return [
    "What should I do next?",
    "What should I ask my GP?",
    "Which symptoms should I record?",
  ];
}

function createResponse(question) {
  const lower = question.toLowerCase();

  if (
    lower.includes("period") ||
    lower.includes("cramp") ||
    lower.includes("pain")
  ) {
    return `Period pain is common, but pain that interrupts work, education, sleep or everyday activities deserves medical attention.

What you can do now:
• Record when the pain begins and how long it lasts.
• Note your bleeding pattern and any bowel, bladder, back or leg symptoms.
• Record which pain-relief methods help.
• Arrange a GP appointment if symptoms are severe, worsening or persistent.

Questions you could ask:
• Could endometriosis, adenomyosis or another condition explain this?
• Would an examination, scan or referral be appropriate?
• What pain-management options are available?

Seek urgent medical help for sudden severe pain, fainting, pregnancy with significant pain or exceptionally heavy bleeding.`;
  }

  if (lower.includes("endometriosis")) {
    return `Endometriosis can cause painful periods, pelvic pain, pain during or after sex, bowel or bladder symptoms, fatigue and fertility difficulties.

A useful next step is to keep a symptom and cycle record. Include the impact on work, education, sleep and daily activities.

A clinician may discuss pain management, hormonal treatment, examination, ultrasound or referral to gynaecology. Symptoms alone cannot confirm endometriosis, so medical assessment is important.`;
  }

  if (
    lower.includes("conceive") ||
    lower.includes("fertility") ||
    lower.includes("ovulation")
  ) {
    return `When trying to conceive, it can help to understand your cycle, general health and when medical advice may be appropriate.

Useful next steps:
• Record cycle dates and changes.
• Review medications and health conditions with a clinician.
• Follow current preconception folic-acid guidance.
• Seek advice earlier if cycles are very irregular, there is severe pelvic pain or either partner has a known fertility concern.

A fertility assessment may include medical history, blood tests, ovulation assessment, ultrasound and semen analysis where relevant.`;
  }

  if (lower.includes("contraception") || lower.includes("pill")) {
    return `The most suitable contraception depends on effectiveness, medical history, bleeding preferences, side effects and whether you want a daily or longer-term option.

Options include combined hormonal methods, progestogen-only methods, implants, injections, intrauterine devices, condoms and fertility-awareness methods.

A contraception clinician can assess which options are medically suitable and help you compare likely benefits and side effects.`;
  }

  if (lower.includes("autoimmune")) {
    return `Autoimmune conditions occur when the immune system mistakenly targets the body’s own tissues. Many autoimmune diseases are more common in women, although symptoms and causes differ between conditions.

Symptoms worth discussing with a clinician may include persistent fatigue, joint pain, unexplained rashes, digestive symptoms, weakness or symptoms that repeatedly flare and settle.

These symptoms can have many possible causes, so a clinician should assess the overall pattern and decide whether tests or specialist referral are appropriate.`;
  }

  return `Thank you for explaining what has been happening.

To identify a useful next step, consider:
• When the symptoms began.
• How often they occur.
• What makes them better or worse.
• Whether they affect sleep, work, education or everyday life.
• Any changes in bleeding, pain, energy, digestion or bladder symptoms.

If symptoms are persistent, severe or worrying, arrange an appointment with a qualified healthcare professional.`;
}
