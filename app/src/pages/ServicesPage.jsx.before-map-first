import { useMemo, useState } from "react";
import { AnimatePresence, motion } from "framer-motion";
import {
  Bookmark,
  CheckCircle2,
  ChevronRight,
  Clock3,
  ExternalLink,
  FileText,
  List,
  Map,
  MapPin,
  Navigation,
  Phone,
  Search,
  SlidersHorizontal,
  Stethoscope,
  UserRoundCheck,
  X,
} from "lucide-react";
import RealServiceMap from "../components/RealServiceMap";
import {
  serviceTopics,
  serviceTypes,
  services,
} from "../data/services";

export default function ServicesPage() {
  const [search, setSearch] = useState("");
  const [type, setType] = useState("All");
  const [topic, setTopic] = useState("All topics");
  const [view, setView] = useState("map");
  const [selectedService, setSelectedService] = useState(null);
  const [savedServices, setSavedServices] = useState([]);

  const filteredServices = useMemo(() => {
    const text = search.trim().toLowerCase();

    return services.filter((service) => {
      const searchableContent = [
        service.name,
        service.type,
        service.topic,
        service.speciality,
        service.location,
        service.description,
        service.referral.route,
        ...service.servicesOffered,
        ...service.suitableFor,
      ]
        .join(" ")
        .toLowerCase();

      const matchesSearch =
        !text || searchableContent.includes(text);

      const matchesType =
        type === "All" || service.type === type;

      const matchesTopic =
        topic === "All topics" || service.topic === topic;

      return matchesSearch && matchesType && matchesTopic;
    });
  }, [search, type, topic]);

  function toggleSaved(id) {
    setSavedServices((current) =>
      current.includes(id)
        ? current.filter((item) => item !== id)
        : [...current, id],
    );
  }

  return (
    <main className="mx-auto w-full max-w-7xl px-5 pb-32 pt-8 md:px-8 lg:px-12">
      <section className="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-pink-50 text-[#f43f72]">
            <MapPin size={24} />
          </div>

          <p className="mt-5 text-sm font-medium text-[#f43f72]">
            SHE Services
          </p>

          <h2 className="mt-2 max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">
            Find the right women’s health service
          </h2>

          <p className="mt-4 max-w-2xl text-base leading-7 text-stone-500 md:text-lg">
            Understand which services may be relevant, how referrals work and
            what to prepare before your appointment.
          </p>
        </div>

        <div className="flex items-center gap-3">
          <div className="rounded-2xl border border-pink-100 bg-white px-5 py-4 shadow-sm">
            <p className="text-sm text-stone-500">Saved services</p>
            <p className="mt-1 text-2xl font-semibold text-[#f43f72]">
              {savedServices.length}
            </p>
          </div>

          <div className="flex rounded-2xl border border-stone-200 bg-white p-1 shadow-sm">
            <button
              type="button"
              onClick={() => setView("list")}
              className={`flex h-11 w-11 items-center justify-center rounded-xl ${
                view === "list"
                  ? "bg-[#241f20] text-white"
                  : "text-stone-500"
              }`}
            >
              <List size={19} />
            </button>

            <button
              type="button"
              onClick={() => setView("map")}
              className={`flex h-11 w-11 items-center justify-center rounded-xl ${
                view === "map"
                  ? "bg-[#241f20] text-white"
                  : "text-stone-500"
              }`}
            >
              <Map size={19} />
            </button>
          </div>
        </div>
      </section>

      <section className="mt-9">
        <label className="flex items-center gap-3 rounded-2xl border border-stone-200 bg-white px-4 py-3 shadow-sm focus-within:border-pink-200 focus-within:ring-4 focus-within:ring-pink-50">
          <Search size={20} className="text-stone-400" />

          <input
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder="Search a symptom, condition or service..."
            className="w-full bg-transparent text-base outline-none placeholder:text-stone-400"
          />
        </label>

        <div className="mt-4 flex items-center gap-2 overflow-x-auto pb-2">
          <div className="mr-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-500">
            <SlidersHorizontal size={16} />
          </div>

          {serviceTypes.map((option) => (
            <FilterButton
              key={option}
              label={option}
              active={type === option}
              onClick={() => setType(option)}
            />
          ))}
        </div>

        <div className="mt-2 flex gap-2 overflow-x-auto pb-2">
          {serviceTopics.map((option) => (
            <FilterButton
              key={option}
              label={option}
              active={topic === option}
              onClick={() => setTopic(option)}
            />
          ))}
        </div>
      </section>

      <div className="mt-7 rounded-2xl bg-pink-50 px-5 py-4 text-sm leading-6 text-stone-600">
        Showing only services and pathways relevant to women’s health. Search
        by symptoms such as “pelvic pain”, “heavy periods”, “fertility” or
        “menopause”.
      </div>

      {view === "map" && (
        <section className="mt-8 grid gap-6 xl:grid-cols-[0.8fr_1.2fr]">
          <div className="space-y-4">
            {filteredServices.map((service, index) => (
              <ServiceCard
                key={service.id}
                service={service}
                index={index}
                saved={savedServices.includes(service.id)}
                toggleSaved={() => toggleSaved(service.id)}
                open={() => setSelectedService(service)}
              />
            ))}
          </div>

          <div className="xl:sticky xl:top-6 xl:h-fit">
            <RealServiceMap
              services={filteredServices}
              selectService={setSelectedService}
            />
          </div>
        </section>
      )}

      {view === "list" && (
        <section className="mt-8 grid gap-5 lg:grid-cols-2">
          {filteredServices.map((service, index) => (
            <ServiceCard
              key={service.id}
              service={service}
              index={index}
              saved={savedServices.includes(service.id)}
              toggleSaved={() => toggleSaved(service.id)}
              open={() => setSelectedService(service)}
            />
          ))}
        </section>
      )}

      {!filteredServices.length && (
        <div className="mt-10 rounded-3xl border border-dashed border-pink-200 bg-pink-50/40 p-10 text-center">
          <MapPin size={35} className="mx-auto text-[#f43f72]" />
          <h3 className="mt-4 text-lg font-semibold">
            No matching services found
          </h3>
          <p className="mt-2 text-sm text-stone-500">
            Try a broader symptom, condition or service type.
          </p>
        </div>
      )}

      <AnimatePresence>
        {selectedService && (
          <ServiceProfile
            service={selectedService}
            saved={savedServices.includes(selectedService.id)}
            toggleSaved={() => toggleSaved(selectedService.id)}
            close={() => setSelectedService(null)}
            openSimilar={setSelectedService}
          />
        )}
      </AnimatePresence>
    </main>
  );
}

function FilterButton({ label, active, onClick }) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={`shrink-0 rounded-full px-4 py-2 text-sm transition ${
        active
          ? "bg-[#241f20] font-medium text-white"
          : "border border-stone-200 bg-white text-stone-600 hover:bg-stone-50"
      }`}
    >
      {label}
    </button>
  );
}

function ServiceCard({
  service,
  index,
  saved,
  toggleSaved,
  open,
}) {
  const Icon = service.icon;

  return (
    <motion.article
      initial={{ opacity: 0, y: 12 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: index * 0.035 }}
      className="rounded-[28px] border border-pink-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >
      <div className="flex gap-4">
        <div className="flex h-13 w-13 shrink-0 items-center justify-center rounded-2xl bg-pink-50 text-[#f43f72]">
          <Icon size={24} />
        </div>

        <div className="min-w-0 flex-1">
          <div className="flex items-start justify-between gap-3">
            <div>
              <div className="flex flex-wrap gap-2">
                <span className="rounded-full bg-pink-50 px-3 py-1 text-xs font-medium text-[#f43f72]">
                  {service.type}
                </span>

                <span className="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-600">
                  {service.topic}
                </span>
              </div>

              <h3 className="mt-3 text-lg font-semibold leading-snug">
                {service.name}
              </h3>
            </div>

            <button
              type="button"
              onClick={toggleSaved}
              className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${
                saved
                  ? "bg-[#f43f72] text-white"
                  : "bg-stone-50 text-stone-500"
              }`}
            >
              <Bookmark
                size={18}
                fill={saved ? "currentColor" : "none"}
              />
            </button>
          </div>

          <p className="mt-3 text-sm font-medium text-stone-700">
            {service.speciality}
          </p>

          <p className="mt-2 flex items-center gap-2 text-sm text-stone-500">
            <MapPin size={15} />
            {service.location}
          </p>

          <div className="mt-4 rounded-2xl bg-stone-50 px-4 py-3">
            <p className="text-xs font-medium uppercase tracking-[0.12em] text-stone-400">
              Referral route
            </p>

            <p className="mt-1 text-sm text-stone-600">
              {service.referral.route}
            </p>
          </div>

          <div className="mt-4 flex items-center justify-between gap-4">
            <span className="flex items-center gap-2 text-xs text-stone-400">
              <Clock3 size={15} />
              {service.waitingTime}
            </span>

            <button
              type="button"
              onClick={open}
              className="flex shrink-0 items-center gap-1 text-sm font-medium text-[#f43f72]"
            >
              Full profile
              <ChevronRight size={16} />
            </button>
          </div>
        </div>
      </div>
    </motion.article>
  );
}

function ServiceProfile({
  service,
  saved,
  toggleSaved,
  close,
  openSimilar,
}) {
  const Icon = service.icon;

  const similarServices = services
    .filter(
      (item) =>
        item.id !== service.id &&
        (item.topic === service.topic ||
          item.type === service.type),
    )
    .slice(0, 3);

  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      exit={{ opacity: 0 }}
      className="fixed inset-0 z-50 flex items-end justify-center bg-black/25 backdrop-blur-sm md:items-center md:p-6"
      onClick={close}
    >
      <motion.article
        initial={{ opacity: 0, y: 45, scale: 0.98 }}
        animate={{ opacity: 1, y: 0, scale: 1 }}
        exit={{ opacity: 0, y: 35, scale: 0.98 }}
        onClick={(event) => event.stopPropagation()}
        className="max-h-[94vh] w-full max-w-4xl overflow-y-auto rounded-t-[32px] bg-white p-6 shadow-2xl md:rounded-[32px] md:p-8"
      >
        <div className="flex items-start justify-between gap-4">
          <div className="flex h-16 w-16 items-center justify-center rounded-2xl bg-pink-50 text-[#f43f72]">
            <Icon size={30} />
          </div>

          <button
            type="button"
            onClick={close}
            className="flex h-10 w-10 items-center justify-center rounded-full bg-stone-100 text-stone-600"
          >
            <X size={19} />
          </button>
        </div>

        <div className="mt-6 flex flex-wrap gap-2">
          <span className="rounded-full bg-pink-50 px-3 py-1 text-xs font-medium text-[#f43f72]">
            {service.type}
          </span>

          <span className="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-600">
            {service.topic}
          </span>
        </div>

        <h2 className="mt-3 text-3xl font-semibold leading-tight md:text-4xl">
          {service.name}
        </h2>

        <p className="mt-2 text-lg font-medium text-stone-700">
          {service.speciality}
        </p>

        <p className="mt-4 max-w-3xl leading-7 text-stone-500">
          {service.description}
        </p>

        <div className="mt-7 grid gap-4 md:grid-cols-3">
          <InfoPanel
            icon={MapPin}
            label="Location"
            value={service.address}
          />

          <InfoPanel
            icon={Stethoscope}
            label="Referral"
            value={service.referral.route}
          />

          <InfoPanel
            icon={Clock3}
            label="Waiting time"
            value={service.waitingTime}
          />
        </div>

        <section className="mt-8 rounded-3xl border border-pink-100 bg-[#fffafa] p-6">
          <div className="flex items-center gap-3">
            <UserRoundCheck size={21} className="text-[#f43f72]" />
            <h3 className="text-xl font-semibold">
              Who may find this relevant?
            </h3>
          </div>

          <div className="mt-4 grid gap-3 sm:grid-cols-2">
            {service.suitableFor.map((item) => (
              <ListItem key={item} text={item} />
            ))}
          </div>
        </section>

        <div className="mt-7 grid gap-6 lg:grid-cols-2">
          <ProfileSection
            icon={CheckCircle2}
            title="Services offered"
            items={service.servicesOffered}
          />

          <ProfileSection
            icon={FileText}
            title="What to prepare"
            items={service.preparation}
          />
        </div>

        <section className="mt-7">
          <h3 className="text-xl font-semibold">
            Referral information
          </h3>

          <div className="mt-4 rounded-3xl bg-stone-50 p-5">
            <p className="font-medium">
              {service.referral.required
                ? "Clinical referral required"
                : "Direct contact or self-referral may be available"}
            </p>

            <p className="mt-2 text-sm leading-6 text-stone-600">
              {service.referral.note}
            </p>
          </div>
        </section>

        <section className="mt-7">
          <h3 className="text-xl font-semibold">
            Related SHE guides
          </h3>

          <div className="mt-4 grid gap-3 sm:grid-cols-3">
            {service.relatedGuides.map((guide) => (
              <button
                key={guide}
                type="button"
                className="rounded-2xl border border-pink-100 bg-white p-4 text-left text-sm font-medium transition hover:bg-pink-50"
              >
                {guide}
                <ChevronRight
                  size={16}
                  className="mt-3 text-[#f43f72]"
                />
              </button>
            ))}
          </div>
        </section>

        {similarServices.length > 0 && (
          <section className="mt-7">
            <h3 className="text-xl font-semibold">
              Similar services and pathways
            </h3>

            <div className="mt-4 grid gap-3 sm:grid-cols-3">
              {similarServices.map((item) => (
                <button
                  key={item.id}
                  type="button"
                  onClick={() => openSimilar(item)}
                  className="rounded-2xl bg-stone-50 p-4 text-left transition hover:bg-pink-50"
                >
                  <p className="text-xs font-medium text-[#f43f72]">
                    {item.type}
                  </p>

                  <p className="mt-2 text-sm font-semibold">
                    {item.name}
                  </p>

                  <p className="mt-2 text-xs text-stone-500">
                    {item.location}
                  </p>
                </button>
              ))}
            </div>
          </section>
        )}

        <div className="mt-8 grid gap-3 border-t border-stone-100 pt-6 sm:grid-cols-2 lg:grid-cols-4">
          <ActionButton
            icon={Phone}
            label="Call service"
            disabled={!service.phone}
          />

          <ActionButton
            icon={ExternalLink}
            label="Visit website"
            disabled={!service.website}
          />

          <ActionButton
            icon={Navigation}
            label="Directions"
          />

          <button
            type="button"
            onClick={toggleSaved}
            className={`flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-medium ${
              saved
                ? "bg-[#241f20] text-white"
                : "border border-pink-200 text-[#f43f72]"
            }`}
          >
            <Bookmark
              size={18}
              fill={saved ? "currentColor" : "none"}
            />
            {saved ? "Saved" : "Save"}
          </button>
        </div>

        <div className="mt-6 rounded-2xl bg-pink-50 p-4 text-xs leading-5 text-stone-500">
          This MVP explains possible access routes but does not determine
          eligibility or provide a diagnosis. Service names, contacts,
          referral rules, availability and locations must be independently
          verified before public launch.
        </div>
      </motion.article>
    </motion.div>
  );
}

function InfoPanel({ icon: Icon, label, value }) {
  return (
    <div className="rounded-2xl bg-stone-50 p-5">
      <Icon size={20} className="text-[#f43f72]" />

      <p className="mt-4 text-xs font-medium uppercase tracking-[0.12em] text-stone-400">
        {label}
      </p>

      <p className="mt-2 text-sm font-medium leading-6">
        {value}
      </p>
    </div>
  );
}

function ProfileSection({ icon: Icon, title, items }) {
  return (
    <section className="rounded-3xl border border-pink-100 bg-white p-6">
      <div className="flex items-center gap-3">
        <Icon size={21} className="text-[#f43f72]" />
        <h3 className="text-xl font-semibold">{title}</h3>
      </div>

      <div className="mt-4 space-y-3">
        {items.map((item) => (
          <ListItem key={item} text={item} />
        ))}
      </div>
    </section>
  );
}

function ListItem({ text }) {
  return (
    <div className="flex items-start gap-3 text-sm leading-6 text-stone-600">
      <span className="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#f43f72]" />
      {text}
    </div>
  );
}

function ActionButton({ icon: Icon, label, disabled = false }) {
  return (
    <button
      type="button"
      disabled={disabled}
      className="flex items-center justify-center gap-2 rounded-full border border-stone-200 px-5 py-3 text-sm font-medium text-stone-700 transition hover:bg-stone-50 disabled:cursor-not-allowed disabled:opacity-40"
    >
      <Icon size={17} />
      {label}
    </button>
  );
}
